{
  "manifest_version": 3,
  "name": "Apex Descarga",
  "version": "2.0.0",
  "description": "Apex Descarga 2.0 Alpha: MP4/MP3 y Smart Merge para partes RAR MediaFire. Procesamiento local mediante Windows.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Apex Descarga 2.0 Alpha 1",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:"
  },
  "minimum_chrome_version": "105"
}
